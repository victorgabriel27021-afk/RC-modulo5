<!DOCTYPE html>
<html>
<head>
  <title>TimeToAnswer</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "admins_backoffice", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
</head>

<body>

<div id="wrapper">

  <%= render "layouts/admins_backoffice_shared/topbar" %>

  <%= render "layouts/admins_backoffice_shared/sidebar" %>

  <div id="page-wrapper">
    <%= yield %>

    <%= render "layouts/admins_backoffice_shared/footer" %>
  </div>

</div>

</body>
</html>